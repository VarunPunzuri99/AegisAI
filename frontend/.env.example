# Public URL of the AegisAI backend (no secrets).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Alias also accepted by the client (optional):
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Phase 17A — Development Authentication demo tokens (must match backend/.env).
# These are demo tokens only — not production credentials.
# Held in the browser bundle for the hackathon demo UI; never use real secrets here.
NEXT_PUBLIC_AEGIS_DEMO_TOKEN_USER=
NEXT_PUBLIC_AEGIS_DEMO_TOKEN_READONLY=
NEXT_PUBLIC_AEGIS_DEMO_TOKEN_AGENT=
NEXT_PUBLIC_AEGIS_DEMO_TOKEN_TENANT_B=
