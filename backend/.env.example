APP_ENV=development
APP_NAME=AegisAI
APP_VERSION=0.1.0
API_PREFIX=/api/v1
LOG_LEVEL=INFO
# Local (no Docker): use localhost. Docker Compose overrides host to "postgres".
DATABASE_URL=postgresql+psycopg://aegisai:aegisai@localhost:5432/aegisai
GROQ_API_KEY=
PROMPT_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
GROQ_DETECTION_MODEL=meta-llama/llama-prompt-guard-2-86m
GROQ_REASONING_MODEL=openai/gpt-oss-safeguard-20b
GROQ_AGENT_MODEL=openai/gpt-oss-20b
PROMPT_GUARD_ENABLED=true
PROMPT_GUARD_MODE=ALWAYS
PROMPT_GUARD_TIMEOUT_SECONDS=10
PROMPT_GUARD_MAX_RETRIES=2
PROMPT_GUARD_MAX_CHUNK_LENGTH=400
PROMPT_GUARD_CHUNK_OVERLAP=40
SAFEGUARD_ENABLED=true
SAFEGUARD_MODEL=openai/gpt-oss-safeguard-20b
SAFEGUARD_MODE=SUSPICIOUS_ONLY
SAFEGUARD_TIMEOUT_SECONDS=10
SAFEGUARD_MAX_RETRIES=2
SAFEGUARD_MAX_TOKENS=1024
# Phase 15 — evaluation harness timeout (does NOT change production detector defaults on disk)
EVALUATION_TIMEOUT_SECONDS=60
# Server-side security mode: NORMAL | DEGRADED | FAIL_CLOSED (never set by models)
AEGIS_SECURITY_MODE=NORMAL
# Phase 17A — development authentication (set real values in backend/.env; never commit tokens)
AEGIS_AUTH_MODE=development
AEGIS_DEMO_TOKEN_USER=
AEGIS_DEMO_TOKEN_READONLY=
AEGIS_DEMO_TOKEN_AGENT=
AEGIS_DEMO_TOKEN_SERVICE=
AEGIS_DEMO_TOKEN_DISABLED=
AEGIS_DEMO_TOKEN_TENANT_B=
# Phase 17B — mock MCP gateway limits
MCP_MAX_RESPONSE_BYTES=65536
MCP_MAX_OUTPUT_ITEMS=50
MCP_TIMEOUT_SECONDS=2.0
MCP_MAX_CALLS_PER_ACTION=1
CORS_ORIGINS=http://localhost:3000
# Backend loads secrets from this file path: backend/.env (not the monorepo root .env).
# Phase 3 preprocessing limits
MAX_INPUT_LENGTH=100000
MAX_DECODED_LENGTH=50000
MAX_DECODE_DEPTH=2
MAX_CHUNKS=64
MAX_CHUNK_LENGTH=1500
CHUNK_OVERLAP_LENGTH=100
MAX_ENCODED_CANDIDATES=16
# Optional live Groq test (never run in default pytest):
# RUN_GROQ_INTEGRATION_TEST=true
# Planned: risk thresholds will be configured here in a later phase.
# RISK_THRESHOLD_ALLOW=
# RISK_THRESHOLD_SANITIZE=
# RISK_THRESHOLD_QUARANTINE=
# RISK_THRESHOLD_BLOCK=
